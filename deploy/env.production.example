# Copy to .env on the server (next to docker-compose.prod.yml) and fill in. Never commit .env.
DOMAIN=careers.example.duckdns.org          # your (sub)domain, already pointing at the server's public IP
POSTGRES_PASSWORD=                          # openssl rand -hex 24
CAREERS_JWT_SECRET=                         # openssl rand -hex 32
CAREERS_ADMIN_EMAILS=you@example.com        # these accounts get the Admin role when they sign up / sign in
CAREERS_PUBLIC_URL=https://careers.example.duckdns.org
CAREERS_CORS_ORIGINS=https://careers.example.duckdns.org
CAREERS_CONTACT=https://github.com/emelian-chkaira/nl-career-tracker
CAREERS_ALLOW_REGISTRATION=1

# Firebase Authentication (see docs/FIREBASE.md)
CAREERS_FIREBASE_API_KEY=
CAREERS_GOOGLE_CLIENT_ID=                   # Firebase Web client ID; add iOS/Android client IDs comma-separated
CAREERS_REQUIRE_VERIFIED_EMAIL=0

# Job-alert e-mails only (Firebase sends verification and reset mails itself). Any SMTP relay: Brevo, Resend, Gmail app password...
# CAREERS_SMTP_HOST=smtp-relay.brevo.com
# CAREERS_SMTP_PORT=587
# CAREERS_SMTP_SECURITY=starttls
# CAREERS_SMTP_USER=
# CAREERS_SMTP_PASSWORD=
# CAREERS_MAIL_FROM=CareerNL <no-reply@yourdomain>

# ANTHROPIC_API_KEY=                        # optional: AI CV tailoring
