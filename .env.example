# Copy to .env. Only DATABASE_URL, CAREERS_JWT_SECRET and CAREERS_ADMIN_EMAILS matter for a first run.
DATABASE_URL=postgresql+psycopg://careers:careers@localhost:5433/careers
CAREERS_JWT_SECRET=              # REQUIRED in production: `openssl rand -hex 32`
CAREERS_ADMIN_EMAILS=            # comma-separated; these accounts get the admin role on registration
CAREERS_ALLOW_REGISTRATION=1
CAREERS_COOKIE_SECURE=0          # 1 behind HTTPS
CAREERS_TRUST_PROXY=0            # 1 behind nginx/Caddy so X-Forwarded-For is used
CAREERS_CORS_ORIGINS=http://localhost:5173
CAREERS_RATE_LIMIT_PER_MIN=240
CAREERS_AUTH_RATE_LIMIT_PER_MIN=20
CAREERS_PUBLIC_URL=http://localhost:8787   # used in alert emails

# Crawler identity (tell site owners who you are)
CAREERS_CONTACT=https://github.com/your-org/nl-career-tracker
CAREERS_BROWSER_SLOTS=3
CAREERS_SCAN_THREADS=10

# Semantic search (fastembed, local model, no API key)
CAREERS_SEMANTIC_ENABLED=1

# E-mail (verification, password reset, job alerts). Without SMTP they are stored as "skipped".
# Test with: cd backend && .venv/bin/python -m scripts.test_mail you@example.com
# CAREERS_SMTP_HOST=smtp.resend.com          # or smtp.postmarkapp.com, email-smtp.eu-west-1.amazonaws.com, smtp.gmail.com
# CAREERS_SMTP_PORT=587                       # 587 + starttls, or 465 + ssl
# CAREERS_SMTP_SECURITY=starttls              # starttls | ssl | none (Mailpit on 1025)
# CAREERS_SMTP_USER=resend                    # Gmail: your address + an App Password
# CAREERS_SMTP_PASSWORD=
# CAREERS_MAIL_FROM=CareerNL <no-reply@yourdomain.nl>   # must be a sender/domain your provider has verified
# CAREERS_PUBLIC_URL=https://careers.yourdomain.nl      # links in the emails

# Firebase Authentication as the identity provider (free tier). When set, sign-up, sign-in, password reset, e-mail verification
# and Google sign-in run through Firebase; this server keeps profiles and issues its own sessions. Existing accounts migrate on next sign-in.
# Firebase console: Authentication > Sign-in method (enable Email/Password and Google); Authentication > Templates > customize the action URL
# for verify/reset to https://your-site/action ; Project settings > General > Web API key.
# CAREERS_FIREBASE_API_KEY=AIza...
# Sign in with Google (free). With Firebase use the Web client ID shown under Authentication > Sign-in method > Google > Web SDK configuration. Google Cloud Console > APIs & Services > Credentials > OAuth client ID.
# Web client: Authorized JavaScript origins = your site URL (and http://localhost:8787 for dev). Comma-separate extra iOS/Android client IDs.
# CAREERS_GOOGLE_CLIENT_ID=1234-abc.apps.googleusercontent.com

# ANTHROPIC_API_KEY=             # optional opt-in "AI polish" for tailored CVs
# CAREERS_LATEX_COMPILE=1        # needs tectonic/pdflatex on PATH
